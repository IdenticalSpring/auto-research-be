# Application
PORT=3001
API_PREFIX=api/v1
NODE_ENV=production
IS_LOCAL=false
CORS_ORIGINS="https://your-frontend-domain.example"
BODY_LIMIT=10mb

# Authentication
JWT_SECRET="replace-with-a-long-random-production-secret"
JWT_EXPIRES_IN=1d

# Local AI Model URL (VPS AI Server - Model: openai/gpt-oss-120b)
LOCALLLM_BASE_URL="http://167.254.70.125:8000/v1"

# AI Model Configuration
# AI_DEFAULT_MODEL: Model ưu tiên số 1 cho toàn bộ luồng. Phải nằm trong AI_ALLOWED_MODELS;
#   nếu rỗng/sai/ngoài whitelist sẽ fallback về phần tử đầu tiên của AI_ALLOWED_MODELS
#   (cuối cùng là deepseek-flash) kèm log cảnh báo.
#   Mặc định dự án là DeepSeek theo quyết định của AI server.
AI_DEFAULT_MODEL="deepseek-flash"
# Whitelist model, phân tách bằng dấu phẩy, giữ thứ tự cấu hình (phần tử đầu là dự phòng).
AI_ALLOWED_MODELS="deepseek-flash,gemini-3.5-flash-lite,localhost"

# Kafka Configuration (VPS AI Server)
KAFKA="167.254.70.125:9092"
KAFKA_CLIENT_ID="autoresearch-backend"
KAFKA_GROUP_ID="autoresearch-group"
KAFKA_SSL=false

# Redis Configuration (VPS AI Server)
REDIS_ENABLED=false
REDIS_URL="redis://167.254.70.125:6379"
REDIS_KEY_PREFIX="autoresearch:"
REDIS_CONNECT_TIMEOUT=10000

# PostgreSQL (Docker Production Container)
POSTGRES_USER=autoresearch
POSTGRES_PASSWORD="replace-with-a-strong-production-password"
POSTGRES_DB=autoresearch

# Kafka bật/tắt — production BẮT BUỘC "true" (fallback mock đã bị chặn ở production)
KAFKA_ENABLED=true

# MongoDB — bắt buộc nếu dùng write_content; KHÔNG hard-code credential trong code
MONGO_URI=

