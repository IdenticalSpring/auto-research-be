# Application
PORT=3001
API_PREFIX=api/v1
NODE_ENV=development
IS_LOCAL=true
CORS_ORIGINS="http://localhost:3000"
BODY_LIMIT=10mb

# Authentication (JWT only; no refresh token)
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN=1d

# Local AI Model URL (VPS AI Server)
LOCALLLM_BASE_URL="http://167.254.70.125:8000/v1"

# AI Model Configuration
# AI_DEFAULT_MODEL: Model ưu tiên số 1 cho TOÀN BỘ luồng (document-setup, write-report,
#   chatbot, enhancement, jobs). Chỉ được chọn khi giá trị nằm trong AI_ALLOWED_MODELS;
#   nếu rỗng/sai/ngoài whitelist, hệ thống fallback về phần tử đầu tiên của AI_ALLOWED_MODELS
#   (cuối cùng là deepseek-flash) và ghi log cảnh báo.
#   MẶC ĐỊNH của dự án là DeepSeek; AI server quyết định model nên BE chỉ gửi `model_id`.
AI_DEFAULT_MODEL="deepseek-flash"
# AI_ALLOWED_MODELS: Whitelist model, phân tách bằng dấu phẩy, GIỮ THỨ TỰ cấu hình.
#   Phần tử đầu tiên là model dự phòng khi AI_DEFAULT_MODEL không hợp lệ.
#   Lưu ý: BE chỉ gửi model_id sang Kafka — API key/provider do AI server (LiteLLM) quản lý.
AI_ALLOWED_MODELS="deepseek-flash,gemini-3.5-flash-lite,localhost"


# Kafka Configuration (VPS AI Server)
KAFKA="167.254.70.125:9092"
KAFKA_CLIENT_ID="autoresearch-backend"
KAFKA_GROUP_ID="autoresearch-group"
KAFKA_SSL=false
# Topic suffix: để rỗng (hoặc KAFKA_USE_LOCAL_TOPICS=false) để kết nối topic chuẩn VPS AI Server
KAFKA_USE_LOCAL_TOPICS=false
KAFKA_TOPIC_SUFFIX=""

# Redis Configuration (VPS AI Server)
REDIS_ENABLED=false
REDIS_URL="redis://167.254.70.125:6379"
REDIS_KEY_PREFIX="autoresearch:"
REDIS_CONNECT_TIMEOUT=10000

# Database Connection (PostgreSQL with Prisma - Local Docker)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/autoresearch?schema=public"

# AI Service Webhook Health-Check Security Key
API_KEY_ID="autoresearch-ai-secret-key"

# Kafka bật/tắt — nguồn cấu hình duy nhất là `kafka.enabled` (src/config/kafka.config.ts)
# Bỏ trống hoặc "true" => BẬT Kafka (bắt buộc ở production). Chỉ đặt "false" khi muốn dùng fallback mock ở dev/test.
KAFKA_ENABLED=

# MongoDB (dùng cho outline/diễn giải của write_content). KHÔNG hard-code, không commit giá trị thật.
# Ví dụ: mongodb://<user>:<password>@<host>:27017/?authSource=admin
MONGO_URI=
