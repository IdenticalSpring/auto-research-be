{
  "name": "auto-research-be",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint src/ test/",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "jest --watch",
    "test:cov": "c8 node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config ./test/jest-e2e.json --forceExit",
    "test:e2e:live": "node --experimental-strip-types scripts/verify-e2e-5steps.ts",
    "test:kafka-smoke": "ts-node --esm scripts/smoke-test-kafka.ts",
    "test:user-guide-smoke": "node scripts/smoke-test-user-guide.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "docker:dev": "bash scripts/dev-setup.sh",
    "docker:down": "docker compose -p auto-research-be-local -f docker-compose.local.yml down",
    "docker:db-push": "docker compose -p auto-research-be-local -f docker-compose.local.yml exec auto-research-be npx prisma db push",
    "live:verify-bugs": "sh scripts/docker-run-script.sh verify-3-fixed-bugs.ts",
    "live:verify-bugs:strict": "sh scripts/docker-run-script.sh verify-3-fixed-bugs.ts --strict-model",
    "live:verify-bugs:dry": "sh scripts/docker-run-script.sh verify-3-fixed-bugs.ts --dry-run",
    "e2e:preflight": "sh scripts/docker-run-script.sh e2e/run-all.ts --tier=preflight",
    "e2e:http": "sh scripts/docker-run-script.sh e2e/run-all.ts --tier=preflight,http",
    "e2e:kafka": "sh scripts/docker-run-script.sh e2e/run-all.ts --tier=preflight,http,kafka",
    "e2e:live": "sh scripts/docker-run-script.sh e2e/run-all.ts --tier=preflight,live --live-tier=smoke",
    "e2e:all": "sh scripts/docker-run-script.sh e2e/run-all.ts --tier=all --live-tier=smoke",
    "e2e:full": "sh scripts/docker-run-script.sh e2e/run-all.ts --tier=all --live-tier=full",
    "e2e:dry": "sh scripts/docker-run-script.sh e2e/run-all.ts --tier=preflight,live --live-tier=smoke --dry-run",
    "e2e:seed-infra": "docker exec autoresearching-ai-dev python scripts/seed_infra_fixtures.py && docker cp autoresearching-ai-dev:/app/reports/infra-fixtures.json reports/infra-fixtures.json",
    "e2e:cleanup-infra": "docker exec autoresearching-ai-dev python scripts/seed_p2_fixtures.py --cleanup",
    "e2e:cleanup-collections": "docker exec autoresearching-ai-dev python scripts/cleanup_e2e_collections.py --yes",
    "e2e:smoke": "docker exec autoresearching-ai-dev python scripts/smoke_all_events.py --model deepseek-flash --out reports/smoke-$(date +%F).json"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/microservices": "^12.0.1",
    "@nestjs/observe": "^0.1.8",
    "@nestjs/platform-express": "^12.0.1",
    "@prisma/client": "^6.19.1",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "ioredis": "^6.0.0",
    "kafkajs": "^2.2.4",
    "mongodb": "^7.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "c8": "^12.0.0",
    "jest": "^30.0.0",
    "oxlint": "1.58.0",
    "prettier": "^3.4.2",
    "prisma": "^6.19.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.2"
  }
}
